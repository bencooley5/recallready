# Optional: recommended for full historical snapshot refreshes.
OPENFDA_API_KEY=

# Optional: enables the historical analyst only when CHAT_ENABLED is true or omitted.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional chat controls.
CHAT_ENABLED=
MAX_CHAT_TURNS_PER_SESSION=5
MAX_CHAT_INPUT_CHARS=500
MAX_TOOL_RESULT_ROWS=50

# Optional operational setting.
LOG_LEVEL=INFO
